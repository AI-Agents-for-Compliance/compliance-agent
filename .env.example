# Entwicklung mit docker compose (Port 5433). Eigene lokale Postgres-Instanz: meist Port 5432 (z. B. .../compliance).
DATABASE_URL=postgresql://dev:dev@localhost:5433/compliance
TEST_DATABASE_URL=postgresql://dev:dev@localhost:5433/compliance_test
M365_CLIENT_ID=
M365_CERT_PATH=./secrets/m365.pem
CONNECT_STATE_SECRET=
APP_URL=http://localhost:3000
# HTTP-Basic-Auth der Demo, Format benutzer:passwort (ohne Wert: App antwortet mit 503)
DEMO_BASIC_AUTH=demo:demo-passwort
